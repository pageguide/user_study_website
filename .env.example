# Credentials for the publish helper (scripts/publish.mjs). Copy to .env — gitignored, never commit.
#
# The SECRET key belongs here and ONLY here. Supabase refuses it from any browser context
# ("Forbidden use of secret API key in browser"), which is why publishing runs from a terminal
# instead of from the extension's panel. Nothing in app/config.js may ever hold this key: that file
# is served to participants.
#
# Find both in: Supabase Dashboard → Project Settings → API.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=<your Supabase secret key>

# The dashboard's "Rerun analysis" button (scripts/publish.mjs --serve). Optional: without it the
# button says the helper has no key and everything else still works.
#
# This key lives here for the same reason the Supabase secret does — app/config.js is served to
# every participant, so a spending credential in the browser is a public spending credential. The
# dashboard asks the loopback helper, which holds the key and never returns it.
#
# OPENROUTER_MODEL is optional; any model id from https://openrouter.ai/models works.

OPENROUTER_API_KEY=<your OpenRouter key, sk-or-v1-…>
OPENROUTER_MODEL=google/gemini-3-flash-preview
